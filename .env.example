# Environment Variables Template
# Copy to .env and configure local credentials. Never commit real credentials.

# MySQL database connection string
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/qwikly_db"

# Runtime Environment
NODE_ENV="development"

# Optional: Enable Prisma query logging ('true' | 'false')
DB_LOG_QUERIES="false"

# Optional: Comma-separated list of allowed CORS origins (e.g. 'http://localhost:3000,https://app.qwikly.com')
ALLOWED_ORIGINS="http://localhost:3000"
